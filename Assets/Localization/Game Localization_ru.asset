  - m_Id: 63360253952
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 \u043D\u0430 \u044D\u043A\u0440\u0430\u043D
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0447\u0430\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 582061441024
    m_Localized: "\u041F\u043E\u0431\u0435\u0434\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2013770334208
    m_Localized: "\u041F\u0440\u043E\u0438\u0433\u0440\u044B\u0448!"
    m_Metadata:
      m_Items: []
  - m_Id: 15499611127808
    m_Localized: "\u041F\u043E\u0445\u043E\u0436\u0435, \u0437\u043B\u043E\u0439
      \u043E\u0440\u0451\u043B \u043F\u043E\u0445\u0438\u0442\u0438\u043B \u043F\u0442\u0438\u0447\u043A\u0443,
      \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0435\u0451 \u0441\u043F\u0430\u0441\u0442\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 63141875597312
    m_Localized: "\u041D\u0443 \u0447\u0442\u043E\u0436, \u0432\u0440\u0435\u043C\u044F
      \u043D\u0430\u0441\u0442\u0430\u043B\u043E, \u0442\u044B \u043F\u0440\u043E\u0448\u0435\u043B
      \u0432\u0441\u0435 \u0443\u0440\u043E\u0432\u043D\u0438 \u0438 \u0442\u0435\u0431\u0435
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0439
      \u0440\u044B\u0432\u043E\u043A \u0434\u043B\u044F \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u044F
      \u043F\u0442\u0438\u0447\u043A\u0438! \u041E\u0442\u043C\u0435\u0447\u0430\u0439
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0435 \u043E\u0442\u0432\u0435\u0442\u044B
      \u043D\u0430 \u043F\u0440\u0438\u043C\u0435\u0440\u044B \u0447\u0442\u043E\u0431\u044B
      \u043D\u0430\u043D\u0435\u0441\u0442\u0438 \u0443\u0440\u043E\u043D \u0431\u043E\u0441\u0441\u0443,
      \u043D\u043E \u0431\u0443\u0434\u044C \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u0435\u043D,
      \u043F\u0440\u0438\u043C\u0435\u0440\u044B \u0431\u0443\u0434\u0443\u0442 \u0440\u0430\u0437\u043D\u044B\u0435
      \u0438 \u0435\u0441\u043B\u0438 \u0442\u044B \u043D\u0435 \u0431\u0443\u0434\u0435\u0448\u044C
      \u043E\u0442\u0432\u0435\u0447\u0430\u0442\u044C \u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438
      15 \u0441\u0435\u043A\u0443\u043D\u0434, \u0431\u043E\u0441\u0441 \u0442\u0435\u0431\u044F
      \u0431\u0443\u0434\u0435\u0442 \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C.
      \u0423\u0434\u0430\u0447\u0438!"
    m_Metadata:
      m_Items: []
